NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# CipherPay app URL (sign-in link when session is missing). For local dev use http://localhost:3000.
NEXT_PUBLIC_CIPHERPAY_APP_URL=https://cp.appfounder.ca

SOLANA_RPC_URL=https://api.devnet.solana.com
DATABASE_URL=mysql://readonly_user:readonly_password@127.0.0.1:3306/cipherpay_server

CIPHERPAY_PROGRAM_ID=
CIPHERPAY_NULLIFIER_RECORD_SEED=nullifier_record
CIPHERPAY_TRANSFER_VKEY_PATH=
CIPHERPAY_WITHDRAW_VKEY_PATH=

# Must match cipherpay-server; for cross-subdomain, server sets Domain=.appfounder.ca
CIPHERPAY_SESSION_COOKIE_NAME=cipherpay_session_nonce

# Dev only: bypass CipherPay session cookie and bind all requests to a fixed user.
# When enabled, zkaudit will use this user for /user/* APIs without requiring a CipherPay cookie.
# Put these in apps/web/.env (Next.js loads .env from the app directory).
# ZKAUDIT_DEV_BYPASS_AUTH=true
# ZKAUDIT_DEV_USER_OWNER_KEY=0x...
